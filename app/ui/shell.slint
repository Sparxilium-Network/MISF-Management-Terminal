// State of the window frame: the top bar, the status line and the main tabs.

// A past result or error the status line can expand to show.
export struct HistoryLine {
    time: string,
    text: string,
    error: bool,
}

export global Shell {
    in property <bool> busy;
    // The running operation can be stopped (a check, test, upgrade or batch).
    in property <bool> stoppable;
    in property <string> status;
    // Newest first.
    in property <[HistoryLine]> history;
    in property <bool> locked;
    in property <bool> encrypted;
    in property <string> storage-warning;
    in property <bool> plaintext-remains;
    in property <string> debug-notice;
    // 0 the host page, 1 the batch view.
    in property <int> view;
    // The host page's tab, then one batch tab per package manager.
    in property <[string]> tabs;
    in property <[int]> tab-ids;
    in property <int> current-tab;
    callback settings();
    callback lock();
    callback unlock();
    callback enable-vault();
    callback manage-keys();
    callback review-plaintext();
    // 0 the host page; from 1 up, that batch tab.
    callback view-chosen(tab: int);
    callback stop();
}
