// The chosen host's page: actions, the advanced menu, statistics and its results.
import { Button } from "std-widgets.slint";
import { Theme, T } from "theme.slint";
import { HintData, HintArea, ColorButton, TextButton, Card } from "widgets.slint";
import { ResultPanel } from "result_panel.slint";

export global HostState {
    in property <bool> has-host;
    in property <string> name;
    in property <string> summary;
    in property <string> check-label;
    in property <string> upgrade-label;
    in property <HintData> delete-hint;
    in property <HintData> test-hint;
    in property <HintData> probe-hint;
    in property <HintData> check-hint;
    in property <HintData> upgrade-hint;
    in property <HintData> dist-hint;
    in property <HintData> reboot-hint;
    in property <bool> upgrade-enabled;
    in property <bool> dist-enabled;
    in property <bool> reboot-enabled;
    in property <string> fingerprint;
    in property <string> pending;
    in property <string> status;
    in property <string> last-check;
    in property <string> kept-back;
    // The deferred packages: their count for the card, the sentence naming them for its hint.
    in property <string> phased;
    in property <string> phased-count;
    // Which of the summary card's items, and the connection line under it, are shown.
    in property <bool> show-pending: true;
    in property <bool> show-phased: true;
    in property <bool> show-status: true;
    in property <bool> show-last-check: true;
    in property <bool> show-connection: true;
    in property <string> restart;
    // The advanced and more menus, drawn by the window above everything at (menu-x, menu-y).
    in-out property <bool> advanced-open;
    in-out property <bool> more-open;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    callback delete();
    callback edit();
    callback test();
    callback probe();
    callback check();
    callback reload();
    callback add-first();
    callback advanced-toggled(open: bool);
    callback more-toggled(open: bool);
    // 0 upgrade, 1 dist-upgrade, 2 reboot.
    callback advanced(item: int);
}

// One item of the summary card in the header's top-right corner; `divider` draws a line
// on its left, after an earlier item.
component Stat inherits HorizontalLayout {
    in property <string> title;
    in property <string> value;
    in property <bool> divider;
    horizontal-stretch: 1;
    if root.divider: Rectangle {
        width: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        min-width: 80px;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 3px;
        Text {
            text: root.title;
            font-size: 11px;
            color: Theme.muted;
        }
        Text {
            text: root.value;
            font-size: 18px;
            font-weight: 700;
            color: Theme.ink;
        }
    }
}

// A drop-down menu's frame; the window places it below its button.
component MenuFrame inherits Rectangle {
    width: 240px;
    height: items.preferred-height;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 6px;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000050;
    TouchArea { }
    items := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        @children
    }
}

// The advanced menu's items.
export component AdvancedMenu inherits MenuFrame {
    HintArea {
        hint: HostState.upgrade-hint;
        active: HostState.upgrade-enabled;
        disabled-text: T.get("apt.upgrade_needs_detect");
        TextButton {
            text: HostState.upgrade-label;
            color: Theme.error;
            enabled: HostState.upgrade-enabled;
            horizontal-stretch: 1;
            clicked => { HostState.advanced(0); }
        }
    }
    HintArea {
        hint: HostState.dist-hint;
        active: HostState.dist-enabled;
        disabled-text: T.get("apt.dist_upgrade_needs_apt");
        TextButton {
            text: T.get("apt.dist_upgrade");
            color: Theme.error;
            enabled: HostState.dist-enabled;
            horizontal-stretch: 1;
            clicked => { HostState.advanced(1); }
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    HintArea {
        hint: HostState.reboot-hint;
        active: HostState.reboot-enabled;
        disabled-text: T.get("reboot.needs_apt");
        TextButton {
            text: T.get("reboot.button");
            color: Theme.error;
            enabled: HostState.reboot-enabled;
            horizontal-stretch: 1;
            clicked => { HostState.advanced(2); }
        }
    }
}

// The more menu: the host's other actions.
export component MoreMenu inherits MenuFrame {
    HintArea {
        hint: HostState.probe-hint;
        TextButton {
            text: T.get("host.fingerprint");
            horizontal-stretch: 1;
            clicked => {
                HostState.more-toggled(false);
                HostState.probe();
            }
        }
    }
    TextButton {
        text: T.get("common.reload");
        horizontal-stretch: 1;
        clicked => {
            HostState.more-toggled(false);
            HostState.reload();
        }
    }
    TextButton {
        text: T.get("host.edit");
        horizontal-stretch: 1;
        clicked => {
            HostState.more-toggled(false);
            HostState.edit();
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    HintArea {
        hint: HostState.delete-hint;
        TextButton {
            text: T.get("host.delete");
            color: Theme.error;
            horizontal-stretch: 1;
            clicked => {
                HostState.more-toggled(false);
                HostState.delete();
            }
        }
    }
}

component HostName inherits Text {
    font-size: 29px;
    font-weight: 700;
    color: Theme.ink;
    overflow: elide;
}

export component HostPage inherits VerticalLayout {
    spacing: 4px;
    if !HostState.has-host: VerticalLayout {
        spacing: 10px;
        alignment: start;
        HostName { text: T.get("host.first_title"); }
        Text {
            text: T.get("host.intro");
            color: Theme.muted;
            wrap: word-wrap;
        }
        Rectangle { height: 40px; }
        Card {
            VerticalLayout {
                padding: 24px;
                spacing: 9px;
                Text {
                    text: T.get("host.start");
                    font-size: 23px;
                    font-weight: 700;
                    color: Theme.ink;
                }
                Text {
                    text: T.get("host.start_description");
                    color: Theme.ink;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    padding-top: 9px;
                    ColorButton {
                        text: T.get("host.add_first");
                        clicked => { HostState.add-first(); }
                    }
                }
            }
        }
    }
    if HostState.has-host: VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        // Left: name, actions and fingerprint. Top right: the cards and the connection.
        HorizontalLayout {
            spacing: 20px;
            VerticalLayout {
            spacing: 4px;
            alignment: start;
            horizontal-stretch: 1;
            HostName { text: HostState.name; }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                padding-top: 4px;
                HintArea {
                    hint: HostState.test-hint;
                    Button {
                        text: T.get("host.test");
                        clicked => { HostState.test(); }
                    }
                }
                HintArea {
                    hint: HostState.check-hint;
                    ColorButton {
                        text: HostState.check-label;
                        clicked => { HostState.check(); }
                    }
                }
                advanced := ColorButton {
                    text: T.get("advanced.button");
                    fill: Theme.red;
                    arrow: true;
                    open: HostState.advanced-open;
                    clicked => {
                        HostState.menu-x = self.absolute-position.x;
                        HostState.menu-y = self.absolute-position.y + self.height + 4px;
                        HostState.advanced-toggled(!HostState.advanced-open);
                    }
                }
                ColorButton {
                    text: T.get("more.button");
                    fill: Theme.navy-selected;
                    arrow: true;
                    open: HostState.more-open;
                    clicked => {
                        HostState.menu-x = self.absolute-position.x;
                        HostState.menu-y = self.absolute-position.y + self.height + 4px;
                        HostState.more-toggled(!HostState.more-open);
                    }
                }
            }
            Text {
                text: HostState.fingerprint;
                font-size: 11px;
                color: Theme.muted;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
            }
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                horizontal-stretch: 0;
                // One card; Preferences choose its items.
                if HostState.show-pending || HostState.show-phased || HostState.show-status || HostState.show-last-check: Card {
                    HorizontalLayout {
                        if HostState.show-pending: Stat {
                            title: T.get("apt.pending");
                            value: HostState.pending;
                        }
                        // The deferred packages' names show on hover.
                        if HostState.show-phased: HintArea {
                            plain: HostState.phased;
                            delay: 0.5s;
                            horizontal-stretch: 1;
                            Stat {
                                title: T.get("apt.phased_count");
                                value: HostState.phased-count;
                                divider: HostState.show-pending;
                            }
                        }
                        if HostState.show-status: Stat {
                            title: T.get("apt.status");
                            value: HostState.status;
                            divider: HostState.show-pending || HostState.show-phased;
                        }
                        if HostState.show-last-check: Stat {
                            title: T.get("apt.last_check");
                            value: HostState.last-check;
                            divider: HostState.show-pending || HostState.show-phased || HostState.show-status;
                        }
                    }
                }
                if HostState.show-connection: Text {
                    text: HostState.summary;
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
            }
        }
        if HostState.kept-back != "": Text {
            text: HostState.kept-back;
            color: Theme.warning;
            wrap: word-wrap;
        }
        if HostState.restart != "": Text {
            text: HostState.restart;
            color: Theme.warning;
            wrap: word-wrap;
        }
        ResultPanel {
            vertical-stretch: 1;
        }
    }
}
