// The main window: top bar, host list, the host or batch page, the status line, and the
// dialogs and menus drawn over them.
// Noto Sans TC (SIL OFL 1.1), embedded so every system draws the same text.
import "../../assets/fonts/NotoSansTC-VariableFont_wght.ttf";
import { Button, Spinner, ScrollView } from "std-widgets.slint";
import { Theme, T, AppearanceSync } from "theme.slint";
import { HintData, Tip, Clip, ClipboardSink, TipOverlay, MenuLine, PopMenu, MenuOverlay, ColorButton, TextButton, Tabs, Card, Modal, Notice, Body } from "widgets.slint";
import { Shell, HistoryLine } from "shell.slint";
import { Sidebar, SidebarState, SidebarRow } from "sidebar.slint";
import { HostPage, HostState, AdvancedMenu } from "host_page.slint";
import { ResultPanel, ResultState, InfoLine } from "result_panel.slint";
import { BatchPage, BatchState, DetailHeading, ManagerChoice, BatchColumnView, BatchCell, BatchRowView } from "batch_page.slint";
import { EditorDialog, EditorState } from "dialogs/editor.slint";
import { KeysDialog, KeysState, KeyView } from "dialogs/keys.slint";
import { VaultDialog, VaultState, SlotView } from "dialogs/vault.slint";
import { UpgradeDialog, UpgradeState, KeptBackDialog, KeptBackState, RebootDialog, RebootState, BatchFailureDialog, BatchFailureState } from "dialogs/confirm.slint";
import { TrustDialog, TrustState, DeleteDialog, DeleteState, GroupDialog, GroupState, PlaintextDialog, PlaintextState, SchemaDialog, SchemaState, CloseDialog, CloseState, ErrorDialog, ErrorState } from "dialogs/simple.slint";
import { SettingsWindow, SettingsState, TreeRow, ColumnToggle } from "settings.slint";
import { TerminalPanel, TerminalState, TerminalTab, TerminalLine } from "terminal.slint";
import { ToolWindow, ToolStripe, DockHandle, DockTitle } from "tool_window.slint";
import { WindowChrome, DragArea, MenuItem, CaptionButtons, WindowEdges } from "title_bar.slint";

export { HintData, Theme, T, Tip, Clip, MenuLine, PopMenu, Shell, HistoryLine, SidebarState, SidebarRow, HostState, ResultState, InfoLine, BatchState, ManagerChoice, BatchColumnView, BatchCell, BatchRowView, EditorState, KeysState, KeyView, VaultState, SlotView, UpgradeState, KeptBackState, RebootState, BatchFailureState, TrustState, DeleteState, GroupState, PlaintextState, SchemaState, CloseState, ErrorState, SettingsWindow, SettingsState, TreeRow, ColumnToggle, TerminalState, TerminalTab, TerminalLine, ToolWindow, WindowChrome }

// This run's past results and errors, newest first: the history tool window.
component HistoryPanel inherits Rectangle {
    in property <length> max-body-height;
    background: Theme.surface;
    VerticalLayout {
        DockHandle {
            max-body-height: root.max-body-height;
        }
        DockTitle {
            title: T.get("status.history");
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: max(80px, ToolWindow.body-height);
            background: Theme.background;
            border-color: Theme.border;
            border-width: 1px;
            if Shell.history.length == 0: Text {
                x: 12px;
                y: 10px;
                text: T.get("status.history_empty");
                font-size: 12px;
                color: Theme.muted;
            }
            if Shell.history.length > 0: ScrollView {
                content-height: lines.preferred-height;
                content-width: self.visible-width;
                lines := VerticalLayout {
                    width: parent.width - 14px;
                    padding: 10px;
                    spacing: 4px;
                    for entry in Shell.history: HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: entry.time;
                            font-family: Theme.mono-font;
                            font-size: 12px;
                            color: Theme.muted;
                        }
                        Body {
                            text: entry.text;
                            font-size: 12px;
                            color: entry.error ? Theme.error : Theme.ink;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}

// The status line. Its arrow, or a click anywhere on it, opens or closes the history.
component StatusBar inherits Rectangle {
    background: Theme.surface;
    line := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: T.get("status.history");
        accessible-expandable: true;
        accessible-expanded: Shell.history-open;
        accessible-action-default => { Shell.history-toggled(); }
        clicked => { Shell.history-toggled(); }
        HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            Rectangle {
                width: 10px;
                Path {
                    width: 10px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 10;
                    viewbox-height: 8;
                    fill: line.has-hover ? Theme.ink : Theme.muted;
                    // Points right when closed and up, toward the open history, when open.
                    commands: Shell.history-open ? "M 1 6.5 L 9 6.5 L 5 1.5 Z" : "M 3 0 L 8 4 L 3 8 Z";
                }
            }
            if Shell.busy: Spinner {
                indeterminate: true;
                width: 16px;
                height: 16px;
            }
            Text {
                text: Shell.status;
                font-size: 12px;
                color: line.has-hover ? Theme.ink : Theme.muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

// The window's own title bar, with the app's top-level commands in it as menu-like
// text, and any storage notices under it.
component TopBar inherits Rectangle {
    property <bool> has-notice: Shell.storage-warning != "" || (Shell.encrypted && Shell.plaintext-remains) || Shell.debug-notice != "";
    background: Theme.surface;
    VerticalLayout {
        Rectangle {
            height: 44px;
            // Behind the buttons: the empty space moves the window.
            DragArea { }
            HorizontalLayout {
                HorizontalLayout {
                    horizontal-stretch: 1;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    VerticalLayout {
                        alignment: center;
                        padding-right: 10px;
                        Image {
                            source: @image-url("../../assets/icons/misf-256.png");
                            width: 18px;
                            height: 18px;
                        }
                    }
                    MenuItem {
                        text: T.get("settings.title");
                        clicked => { Shell.settings(); }
                    }
                    if Shell.encrypted && Shell.locked: MenuItem {
                        text: T.get("vault.unlock_host");
                        enabled: !Shell.busy;
                        clicked => { Shell.unlock(); }
                    }
                    if Shell.encrypted && !Shell.locked: MenuItem {
                        text: T.get("vault.lock");
                        enabled: !Shell.busy;
                        clicked => { Shell.lock(); }
                    }
                    if !Shell.encrypted: MenuItem {
                        text: T.get("vault.enable_button");
                        enabled: !Shell.busy;
                        clicked => { Shell.enable-vault(); }
                    }
                    if !Shell.locked: MenuItem {
                        text: T.get("keys.manage");
                        enabled: !Shell.busy;
                        clicked => { Shell.manage-keys(); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                CaptionButtons { }
            }
        }
        if root.has-notice: VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 10px;
            spacing: 6px;
            if Shell.storage-warning != "": Notice {
                error: true;
                text: Shell.storage-warning;
            }
            if Shell.encrypted && Shell.plaintext-remains: HorizontalLayout {
                spacing: 10px;
                Notice {
                    text: T.get("storage.original_remains");
                    vertical-alignment: center;
                }
                Button {
                    text: T.get("plaintext.review");
                    enabled: !Shell.locked && !Shell.busy;
                    clicked => { Shell.review-plaintext(); }
                }
            }
            if Shell.debug-notice != "": Notice {
                text: Shell.debug-notice;
            }
        }
    }
}

component LockedPage inherits VerticalLayout {
    spacing: 12px;
    alignment: start;
    Text {
        text: T.get("app.vault_heading");
        font-size: 10px;
        font-weight: 700;
        color: Theme.muted;
    }
    Text {
        text: Shell.encrypted ? T.get("vault.locked") : T.get("vault.setup_heading");
        font-size: 29px;
        font-weight: 700;
        color: Theme.ink;
    }
    Text {
        text: Shell.encrypted ? T.get("vault.unlock_description") : T.get("vault.setup_description");
        color: Theme.ink;
        wrap: word-wrap;
    }
    Rectangle { height: 12px; }
    Card {
        VerticalLayout {
            padding: 18px;
            padding-top: 30px;
            padding-bottom: 30px;
            spacing: 12px;
            Text {
                text: T.get("vault.algorithm");
                color: Theme.ink;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                ColorButton {
                    text: Shell.encrypted ? T.get("vault.unlock_host") : T.get("vault.enable_button");
                    clicked => {
                        if (Shell.encrypted) {
                            Shell.unlock();
                        } else {
                            Shell.enable-vault();
                        }
                    }
                }
            }
        }
    }
}

component Workspace inherits Rectangle {
    background: Theme.background;
    VerticalLayout {
        padding: 28px;
        // The pages keep 14px more for their scroll bar.
        padding-right: 14px;
        spacing: 8px;
        if Shell.locked: LockedPage { }
        if !Shell.locked: Tabs {
            labels: [T.get("view.host"), Shell.batch-tab];
            ids: [0, 1];
            current: Shell.view;
            chosen(id) => { Shell.view-chosen(id); }
        }
        // A page fills the room it gets; when a tool window leaves it less than the page
        // needs, the page keeps its size and scrolls instead of being cut off.
        if !Shell.locked && Shell.view == 0: host-view := ScrollView {
            vertical-stretch: 1;
            min-height: 120px;
            content-width: max(self.visible-width, host.min-width + 14px);
            content-height: max(self.visible-height, host.min-height);
            host := HostPage {
                x: 0;
                y: 0;
                // Clear of the scroll bar.
                width: host-view.content-width - 14px;
                height: host-view.content-height;
            }
        }
        if !Shell.locked && Shell.view == 1: batch-view := ScrollView {
            vertical-stretch: 1;
            min-height: 120px;
            content-width: max(self.visible-width, batch.min-width + 14px);
            content-height: max(self.visible-height, batch.min-height);
            batch := BatchPage {
                x: 0;
                y: 0;
                // Clear of the scroll bar.
                width: batch-view.content-width - 14px;
                height: batch-view.content-height;
            }
        }
    }
    // Pages ignore input while work runs.
    if Shell.busy: TouchArea { }
}

export component AppWindow inherits Window {
    in property <bool> debug;
    title: root.debug ? "MISF · DEBUG · Isolated profile" : "MISF · Management Terminal";
    icon: @image-url("../../assets/icons/misf-256.png");
    // The title bar is drawn here (TopBar).
    no-frame: true;
    min-width: 1024px;
    min-height: 700px;
    preferred-width: 1280px;
    preferred-height: 820px;
    background: Theme.background;
    default-font-size: 14px;
    default-font-family: Theme.font-family;
    default-font-weight: Theme.font-weight;
    // The tool window body's tallest height, leaving the pages at least 420px. Applied when
    // the window changes size, not bound, since the window's height follows its layout.
    property <length> tool-limit: max(80px, self.height - 420px);
    changed height => {
        ToolWindow.body-height = min(ToolWindow.body-height, self.tool-limit);
    }
    AppearanceSync { }
    ClipboardSink { }
    // Runs a chosen right-click menu line.
    function run-menu(line: MenuLine) {
        if (line.action == "copy") {
            Clip.copy(line.arg);
        } else if (line.action == "open-host") {
            BatchState.open-host(line.arg);
        } else if (line.action == "open-detail") {
            BatchState.open-detail(line.arg);
        } else if (line.action == "rename-group") {
            SidebarState.rename-group(line.arg);
        } else if (line.action == "delete-group") {
            SidebarState.delete-group(line.arg);
        }
    }
    VerticalLayout {
        TopBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            ToolStripe { }
            VerticalLayout {
                // The open tool window takes its height from here: the pages may be shorter
                // than they would like, and are clipped at the bottom rather than pushing
                // the status line out of the window.
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 200px;
                    clip: true;
                    HorizontalLayout {
                        Sidebar {
                            width: 280px;
                            busy: Shell.busy;
                        }
                        Workspace {
                            horizontal-stretch: 1;
                        }
                    }
                }
                // Under the pages and sidebar, like an IDE's tool windows.
                if ToolWindow.open == 1: TerminalPanel {
                    max-body-height: root.tool-limit;
                }
                if ToolWindow.open == 2: HistoryPanel {
                    max-body-height: root.tool-limit;
                }
            }
        }
        status-bar := StatusBar { }
    }
    if BatchState.popup-shown: Modal {
        width: root.width;
        height: root.height;
        panel-width: max(480px, min(1400px, root.width - 120px));
        max-panel-height: root.height - 60px;
        dismissed => { BatchState.close-popup(); }
        HorizontalLayout {
            spacing: 10px;
            DetailHeading {
                horizontal-stretch: 1;
            }
            Button {
                text: T.get("common.close");
                clicked => { BatchState.close-popup(); }
            }
        }
        ResultPanel {
            vertical-stretch: 1;
            min-height: max(160px, root.height - 300px);
        }
    }
    if EditorState.shown: EditorDialog {
        width: root.width;
        height: root.height;
    }
    if TrustState.shown: TrustDialog {
        width: root.width;
        height: root.height;
    }
    if DeleteState.shown: DeleteDialog {
        width: root.width;
        height: root.height;
    }
    if UpgradeState.shown: UpgradeDialog {
        width: root.width;
        height: root.height;
    }
    if KeptBackState.shown: KeptBackDialog {
        width: root.width;
        height: root.height;
    }
    if BatchFailureState.shown: BatchFailureDialog {
        width: root.width;
        height: root.height;
    }
    if RebootState.shown: RebootDialog {
        width: root.width;
        height: root.height;
    }
    if VaultState.shown: VaultDialog {
        width: root.width;
        height: root.height;
    }
    if SchemaState.shown: SchemaDialog {
        width: root.width;
        height: root.height;
    }
    if PlaintextState.shown: PlaintextDialog {
        width: root.width;
        height: root.height;
    }
    // After the editor, so it opens on top when chosen from there.
    if KeysState.shown: KeysDialog {
        width: root.width;
        height: root.height;
    }
    if GroupState.shown: GroupDialog {
        width: root.width;
        height: root.height;
    }
    // Above the other dialogs: it answers the window's close button.
    if CloseState.shown: CloseDialog {
        width: root.width;
        height: root.height;
    }
    if ErrorState.shown: ErrorDialog {
        width: root.width;
        height: root.height;
    }
    if HostState.advanced-open: Rectangle {
        width: root.width;
        height: root.height;
        // A left click outside the menu closes it; right-clicks open the items' copy menus.
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    HostState.advanced-toggled(false);
                }
            }
        }
        AdvancedMenu {
            x: min(HostState.menu-x, root.width - self.width - 8px);
            y: HostState.menu-y;
        }
    }
    if PopMenu.shown: MenuOverlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        window-width: root.width;
        window-height: root.height;
        chosen(line) => { root.run-menu(line); }
    }
    TipOverlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        window-width: root.width;
        window-height: root.height;
    }
    // Last, so the resize grips sit over everything.
    WindowEdges {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }
}
